# Copy to .env to change settings. With no .env and no API key the app runs in
# FAKE MODEL MODE, so it starts with one command and no key.

# auto = Claude when ANTHROPIC_API_KEY is set, otherwise the fake model.
# Set to "fake" to force the fake model, or "anthropic" to require Claude.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=

# Fast tier: sorting and the three checks. Strong tier: drafting and reviewing.
# Any model listed in app/pricing.py works, e.g. claude-fable-5-2 for the strong tier.
MODEL_FAST=claude-haiku-5-5
MODEL_STRONG=claude-sonnet-5-5

DB_PATH=data/mission_control.db
PORT=8000
